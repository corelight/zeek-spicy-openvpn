module zeek_spicy_openvpn;

import spicy;

%byte-order = spicy::ByteOrder::Big;

type Context = tuple<initialized: bool, is_tls_crypt: bool>;

type Opcode = enum {
	P_CONTROL_HARD_RESET_CLIENT_V1	= 0x01,
	P_CONTROL_HARD_RESET_SERVER_V1	= 0x02,
	P_CONTROL_SOFT_RESET_V1		= 0x03,
	P_CONTROL_V1			= 0x04,
	P_ACK_V1			= 0x05,
	P_DATA_V1			= 0x06,
	P_CONTROL_HARD_RESET_CLIENT_V2	= 0x07,
	P_CONTROL_HARD_RESET_SERVER_V2	= 0x08,
	P_DATA_V2			= 0x09,
	P_CONTROL_HARD_RESET_CLIENT_V3	= 0x0a,
	P_CONTROL_WKC_V1		= 0x0b
};

public type OpenVPNRecords = unit {
	%context = Context;

	records: OpenVPNRecord(0, self.context().is_tls_crypt)[];
};

public type OpenVPNRecordsHMACMD5 = unit {
	%context = Context;

	records: OpenVPNRecord(16, self.context().is_tls_crypt)[];
};

public type OpenVPNRecordsHMACSHA1 = unit { ##
	%context = Context;

	records: OpenVPNRecord(20, self.context().is_tls_crypt)[]; # 160 bit
};

public type OpenVPNRecordsHMACSHA256 = unit {
	%context = Context;

	records: OpenVPNRecord(32, self.context().is_tls_crypt)[];
	on records foreach {
		if ( $$.message_type.opcode == Opcode::P_CONTROL_HARD_RESET_CLIENT_V3 ||
		     $$.message_type.opcode == Opcode::P_CONTROL_WKC_V1 )
			self.context().is_tls_crypt = True;
	}
};

public type OpenVPNRecordsHMACSHA512 = unit {
	%context = Context;

	records: OpenVPNRecord(64, self.context().is_tls_crypt)[];
};

type OpenVPNRecord = unit(hmac_size: uint32, is_tls_crypt: bool) {
	message_type: bitfield(8) {
		opcode: 3..7 &convert=Opcode($$);
		key_id: 0..2;
	};

	switch ( self.message_type.opcode ) {
		Opcode::P_CONTROL_HARD_RESET_CLIENT_V1 -> control_hard_reset_client_v1: ControlMessage(self.message_type.opcode, self.message_type.key_id, hmac_size);
		Opcode::P_CONTROL_HARD_RESET_SERVER_V1 -> control_hard_reset_server_v1: ControlMessage(self.message_type.opcode, self.message_type.key_id, hmac_size);
		Opcode::P_CONTROL_SOFT_RESET_V1 -> control_soft_reset_v1: ControlMessageDispatch(self.message_type.opcode, self.message_type.key_id, hmac_size, is_tls_crypt);
		Opcode::P_CONTROL_V1 -> control_v1: ControlMessageDispatch(self.message_type.opcode, self.message_type.key_id, hmac_size, is_tls_crypt);
		Opcode::P_ACK_V1 -> ack_v1: AckMessageDispatch(self.message_type.opcode, self.message_type.key_id, hmac_size, is_tls_crypt);
		Opcode::P_DATA_V1 -> data_v1: DataMessage(self.message_type.opcode, self.message_type.key_id, False);
		Opcode::P_CONTROL_HARD_RESET_SERVER_V2 -> control_hard_reset_server_v2: ControlMessageDispatch(self.message_type.opcode, self.message_type.key_id, hmac_size, is_tls_crypt);
		Opcode::P_CONTROL_HARD_RESET_CLIENT_V2 -> control_hard_reset_client_v2: ControlMessage(self.message_type.opcode, self.message_type.key_id, hmac_size);
		Opcode::P_DATA_V2 -> data_v2: DataMessage(self.message_type.opcode, self.message_type.key_id, True);
		Opcode::P_CONTROL_HARD_RESET_CLIENT_V3 -> control_hard_reset_client_v3: ControlMessageTlsCryptInit(self.message_type.opcode, self.message_type.key_id);
		Opcode::P_CONTROL_WKC_V1 -> control_wkc_v1: ControlMessageTlsCryptInit(self.message_type.opcode, self.message_type.key_id);
	};
};

public type OpenVPNRecordsTCP = unit {
	%context = Context;

	records: OpenVPNRecordTCP(0, self.context().is_tls_crypt)[];
};

public type OpenVPNRecordsTCPHMACMD5 = unit {
	%context = Context;

	records: OpenVPNRecordTCP(16, self.context().is_tls_crypt)[];
};

public type OpenVPNRecordsTCPHMACSHA1 = unit {
	%context = Context;

	records: OpenVPNRecordTCP(20, self.context().is_tls_crypt)[];
};

public type OpenVPNRecordsTCPHMACSHA256 = unit {
	%context = Context;

	records: OpenVPNRecordTCP(32, self.context().is_tls_crypt)[];
	on records foreach {
		if ( $$.record.message_type.opcode == Opcode::P_CONTROL_HARD_RESET_CLIENT_V3 ||
		     $$.record.message_type.opcode == Opcode::P_CONTROL_WKC_V1 )
			self.context().is_tls_crypt = True;
	}
};

public type OpenVPNRecordsTCPHMACSHA512 = unit {
	%context = Context;

	records: OpenVPNRecordTCP(64, self.context().is_tls_crypt)[];
};

type OpenVPNRecordTCP = unit(hmac_size: uint32, is_tls_crypt: bool) {
	packet_length: uint16;

	record: OpenVPNRecord(hmac_size, is_tls_crypt) &size=self.packet_length;
};

type HMACInfo = unit(hmac_size: uint32) {
	hmac : bytes &size=hmac_size;
	packet_id: uint32;
	net_time: bytes &size=4;
};

type HMACTlsCrypt = unit {
	replay_packet_id: uint32;
	net_time: bytes &size=4;
	hmac : bytes &size=32;
};

public type ControlMessage = unit(opcode: Opcode, key_id: uint8, hmac_size: uint32) {
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	session_id: bytes &size=8;
	hmac: HMACInfo(hmac_size) if (hmac_size > 0);
	packet_id_array_len: uint8;
	packet_id_array: uint32[self.packet_id_array_len];
	remote_session_id: bytes &size=8 if (self.packet_id_array_len > 0);
	packet_id: uint32;
	ssl_data: bytes &eod;
};

public type ControlMessageTlsCryptInit = unit(opcode: Opcode, key_id: uint8) {
	var start: iterator<stream>;
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	session_id: bytes &size=8;
	hmac: HMACTlsCrypt;
	data: bytes &eod { self.start = self.input() + self.offset(); self.set_input(self.start + (|self.data| - 2)); }
	# wkc covers the full WKC block including the trailing length field.
	wkc_length: uint16 { self.set_input(self.start + (|self.data| - self.wkc_length)); }
	wkc: bytes &eod;
};

type ControlMessageTlsCrypt = unit(opcode: Opcode, key_id: uint8) {
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	session_id: bytes &size=8;
	hmac: HMACTlsCrypt;
	data: bytes &eod;
};

type ControlMessageDispatch = unit(opcode: Opcode, key_id: uint8, hmac_size: uint32, is_tls_crypt: bool) {
	switch ( is_tls_crypt ) {
		True  -> tls:   ControlMessageTlsCrypt(opcode, key_id);
		False -> plain: ControlMessage(opcode, key_id, hmac_size);
	};
};

type AckMessageTlsCrypt = unit(opcode: Opcode, key_id: uint8) {
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	session_id: bytes &size=8;
	hmac: HMACTlsCrypt;
	data: bytes &eod;
};

type AckMessageDispatch = unit(opcode: Opcode, key_id: uint8, hmac_size: uint32, is_tls_crypt: bool) {
	switch ( is_tls_crypt ) {
		True  -> tls:   AckMessageTlsCrypt(opcode, key_id);
		False -> plain: AckMessage(opcode, key_id, hmac_size);
	};
};

type AckMessage = unit(opcode: Opcode, key_id: uint8, hmac_size: uint32) {
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	session_id: bytes &size=8;
	hmac: HMACInfo(hmac_size) if (hmac_size > 0);
	packet_id_array_len : uint8;
	packet_id_array: uint32[self.packet_id_array_len];
	remote_session_id: bytes &size=8 if (self.packet_id_array_len > 0);
	data: bytes &eod;
};

type DataMessage = unit(opcode: Opcode, key_id: uint8, is_v2: bool) {
	var opcode: Opcode = opcode;
	var key_id: uint8 = key_id;
	peer_id: bytes &size=3 if (is_v2);
	payload: bytes &eod;
};
